SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ums
DB_USERNAME=ums
DB_PASSWORD=ums

REDIS_HOST=localhost
REDIS_PORT=6379

# JWT RSA key pair (PEM). Locally: classpath:keys/*.pem; on servers: file:/path/to/key.pem
JWT_PUBLIC_KEY=classpath:keys/public.pem
JWT_PRIVATE_KEY=classpath:keys/private.pem
JWT_KEY_ID=ums-key-1

STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ums

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Mail server for password reset codes (leave unset locally: the dev profile logs the code instead)
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=no-reply@your-university.edu.kh

# First administrator on a new server (SIT, UAT, PROD): created at start-up only if no SUPER_ADMIN exists.
# At least 12 characters; it must be changed at first login. Remove these after the first login.
# UMS_ADMIN_USERNAME=admin
# UMS_ADMIN_PASSWORD=
# UMS_ADMIN_EMAIL=admin@your-university.edu.kh

# API language when the app sends no Accept-Language and nobody is logged in: km or en
# DEFAULT_LANGUAGE=en
